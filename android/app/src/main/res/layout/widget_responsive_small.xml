<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card_light"
    android:padding="12dp">

    <!-- Header Atas: Tanggal & Tombol [+] -->
    <LinearLayout
        android:id="@+id/small_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/widget_icon_paw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hari Ini"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#5C544E"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_add_task"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_add_light"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Konten Tengah: Maskot Kucing & Counter Progres -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_mascot_face"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="( ^ . ^ )"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#D96B43"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_counter_light"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="0/0 Selesai"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#D96B43" />

        <TextView
            android:id="@+id/widget_status_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semua tugas beres!"
            android:textSize="10.5sp"
            android:textColor="#7A716A"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</RelativeLayout>
